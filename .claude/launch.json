{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "dev-run",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "start",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3001,
      "autoPort": true
    }
  ]
}
