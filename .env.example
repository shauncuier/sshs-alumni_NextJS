# Environment variables for Sabuj Shikshayatan Government High School Alumni Platform
#
# Local development: copy to .env.local. Production: see docs/PRODUCTION_ENV.md and
# check the file with `npm run env:check -- <file>` before deploying. In production
# the server refuses to start with a missing or published secret, no super admin,
# or a non-https address.

# MariaDB / MySQL Connection String (Single source of truth for Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/sshs_alumni"

# Test Database (used for npm test; start local container with `npm run test:db`)
TEST_DATABASE_URL="mysql://root:test@127.0.0.1:3307/sshs_test"

# Local Storage for User Uploads (avatars and private verification proofs)
# Defaults to ./uploads in project root if omitted
UPLOADS_DIR="./uploads"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SCHOOL_NAME="Sabuj Shikshayatan Government High School"
NEXT_PUBLIC_SCHOOL_SHORT_NAME="SSGHS"
NEXT_PUBLIC_SCHOOL_BENGALI_NAME="সবুজ শিক্ষায়তন সরকারি উচ্চ বিদ্যালয়"
NEXT_PUBLIC_SCHOOL_EIIN="105070"
NEXT_PUBLIC_SCHOOL_LOCATION="Chattogram, Bangladesh"
NEXT_PUBLIC_SCHOOL_WEBSITE="https://sabujsghs.edu.bd/"

# Bangla QR payment option on the registration form: the association's bank-issued
# QR image (put it in public/, e.g. "/bangla-qr.png", or use a full URL) and the
# merchant name printed with it. Without an image the option still shows, with
# instructions only.
NEXT_PUBLIC_BANGLA_QR_IMAGE=""
NEXT_PUBLIC_BANGLA_QR_MERCHANT=""

# Donations are paid manually and verified by the committee. Shown on /donate as
# "How to pay"; separate lines with "|", e.g.
# "bKash (personal): 01XXXXXXXXX|Nagad: 01XXXXXXXXX|Bank: SSGHS Alumni Association, A/C 123..., Sonali Bank"
NEXT_PUBLIC_DONATION_INSTRUCTIONS=""
# Online checkout through bKash / Nagad / SSLCommerz merchant APIs. Off until the
# association has merchant accounts (then also set the gateway keys below).
ONLINE_PAYMENTS_ENABLED="false"

# Super admin (the only SUPER_ADMIN account). Created or synced at every server
# start, or now with `npm run db:super-admin`. Changing the password here and
# restarting resets it and signs the old sessions out. Password: 12+ characters.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Seed accounts (`npm run db:seed`, LOCAL ONLY), one per role besides the super admin
# above. Passwords: 12+ characters, required by the seed. Leave out in production.
SEED_ADMIN_EMAIL="admin@sabujsghs.edu.bd"
SEED_ADMIN_PASSWORD=""
SEED_MODERATOR_EMAIL="moderator@sabujsghs.edu.bd"
SEED_MODERATOR_PASSWORD=""
SEED_ALUMNI_EMAIL="jashedul@example.com"
SEED_ALUMNI_PASSWORD=""

# Activity log (/admin/logs): entries older than this many days are deleted at server start.
LOG_RETENTION_DAYS="365"

# Authentication secret: signs sessions, member cards and event tickets. Generate a
# different one per environment with: openssl rand -base64 32 (32+ characters).
# Changing it signs everyone out and invalidates issued cards and tickets.
NEXTAUTH_SECRET=""
# Production: the site's https:// address, the same as NEXT_PUBLIC_APP_URL.
NEXTAUTH_URL="http://localhost:3000"

# ═══════════════════════════════════════════════════════════════════════
# Phase 2: Payment Gateways
# ═══════════════════════════════════════════════════════════════════════

# bKash Tokenized Checkout API
# Docs: https://developer.bka.sh/docs/checkout-process-overview
BKASH_SANDBOX="true"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# Nagad Payment Gateway
# Docs: https://nagad.com.bd/merchant
NAGAD_SANDBOX="true"
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_KEY=""
NAGAD_PG_PUBLIC_KEY=""
NAGAD_MERCHANT_PRIVATE_KEY=""

# SSLCommerz Payment Aggregator
# Docs: https://developer.sslcommerz.com/doc/v4/
SSLCOMMERZ_SANDBOX="true"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""

# ═══════════════════════════════════════════════════════════════════════
# Phase 2: Email & SMS Services
# ═══════════════════════════════════════════════════════════════════════

# Resend Email API (recommended — https://resend.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SSGHS Alumni <alumni@sabujsghs.edu.bd>"

# SMTP Fallback (Gmail / Custom SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SSGHS Alumni <alumni@sabujsghs.edu.bd>"

# Where contact-form messages are emailed (Reply-To is the sender). Without it they
# are kept only in the activity log (/admin/logs).
CONTACT_INBOX_EMAIL=""

# Bangladesh SMS Gateway (BulkSMSBD - https://bulksmsbd.com)
BULKSMSBD_API_KEY=""
BULKSMSBD_SENDER_ID=""
BULKSMSBD_URL="https://bulksmsbd.net/api/smsapi"
BULKSMSBD_BALANCE_URL="https://bulksmsbd.net/api/getBalanceApi"
# Brand in the registration OTP SMS ("Your {Brand} OTP is 1234"); must match the
# OTP template approved by BulkSMSBD. Defaults to "SSGHS Alumni".
OTP_BRAND_NAME="SSGHS Alumni"

# Generic SMS Gateway Fallback (Greenweb / Reve SMS)
SMS_GATEWAY_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="SSGHS"


