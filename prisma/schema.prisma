datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  ALUMNI
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EventCategory {
  REUNION
  SPORTS
  WEBINAR
  CULTURAL
  COMMUNITY
}

enum CampaignCategory {
  SCHOLARSHIP
  STEM_LAB
  LIBRARY
  EMERGENCY_AID
  CAMPUS_DEV
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentGateway {
  BKASH
  NAGAD
  SSLCOMMERZ
  BANK_TRANSFER
  MANUAL
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  passwordHash         String
  role                 Role                 @default(ALUMNI)
  status               VerificationStatus   @default(PENDING)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  profile              AlumniProfile?
  posts                Post[]
  comments             Comment[]
  eventRegistrations   EventRegistration[]
  donations            Donation[]
  sentMessages         Message[]            @relation("SentMessages")
  receivedMessages     Message[]            @relation("ReceivedMessages")
  notifications        Notification[]
  verificationRequests VerificationRequest[]
}

model AlumniProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName           String
  sscBatch           Int                // e.g. 2008
  graduationYear     Int                // e.g. 2008
  rollNumber         String?
  section            String?
  gender             String?
  profession         String
  company            String?
  industry           String?
  locationCity       String             // e.g. Dhaka
  locationCountry    String             // e.g. Bangladesh
  bio                String?
  avatarUrl          String?
  coverUrl           String?
  phone              String?
  isPhonePublic      Boolean            @default(false)
  isEmailPublic      Boolean            @default(false)
  skills             Json               @default("[]")
  linkedin           String?
  facebook           String?
  github             String?
  website            String?
  schoolMemories     String?
  contributions      String?
  verificationStatus VerificationStatus @default(PENDING)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Batch {
  id                  String    @id @default(uuid())
  year                Int       @unique // e.g. 2008
  name                String    // e.g. "SSC Batch 2008"
  tagline             String?
  totalMembers        Int       @default(0)
  classRepresentative String?
  representativePhone String?
  reunionDate         DateTime?
  reunionCount        Int       @default(0)
  coverImage          String?
  description         String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Post {
  id            String    @id @default(uuid())
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  batchTag      Int?
  content       String
  images        Json      @default("[]")
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  isPinned      Boolean   @default(false)

  comments      Comment[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id                  String          @id @default(uuid())
  slug                String          @unique
  title               String
  category            EventCategory   @default(REUNION)
  description         String
  date                DateTime
  time                String?
  venue               String
  locationCity        String          @default("Dhaka")
  organizer           String?
  bannerImage         String?
  bannerUrl           String?
  maxAttendees        Int             @default(500)
  totalSeats          Int             @default(500)
  confirmedSeats      Int             @default(0)
  attendeesCount      Int             @default(0)
  registrationFee     Float           @default(0)
  isRegistrationOpen  Boolean         @default(true)

  registrations       EventRegistration[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model EventRegistration {
  id             String   @id @default(uuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  guestCount     Int      @default(1)
  mealPreference String?
  notes          String?

  createdAt      DateTime @default(now())
}

model DonationCampaign {
  id           String           @id @default(uuid())
  slug         String           @unique
  title        String
  category     CampaignCategory @default(SCHOLARSHIP)
  description  String
  goalAmount   Float            @default(0)
  targetAmount Float            @default(0)
  raisedAmount Float            @default(0)
  donorCount   Int              @default(0)
  bannerImage  String?
  imageUrl     String?
  isActive     Boolean          @default(true)
  startDate    DateTime         @default(now())
  endDate      DateTime?

  donations    Donation[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Donation {
  id             String           @id @default(uuid())
  campaignId     String
  campaign       DonationCampaign @relation(fields: [campaignId], references: [id])
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  donorName      String
  donorEmail     String?
  donorPhone     String?
  donorBatch     Int?
  amount         Float
  paymentMethod  String           // "bKash", "Nagad", "Card", "Bank"
  paymentGateway PaymentGateway   @default(BKASH)
  paymentStatus  PaymentStatus    @default(INITIATED)
  isAnonymous    Boolean          @default(false)
  transactionRef String?
  gatewayTrxId   String?
  receiptId      String?
  receiptUrl     String?
  paidAt         DateTime?
  failureReason  String?
  ipnPayload     String?

  transaction    PaymentTransaction?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model PaymentTransaction {
  id                String         @id @default(uuid())
  donationId        String         @unique
  donation          Donation       @relation(fields: [donationId], references: [id], onDelete: Cascade)
  gateway           PaymentGateway
  gatewaySessionKey String?
  gatewayTrxId      String?
  amount            Float
  currency          String         @default("BDT")
  status            PaymentStatus  @default(INITIATED)
  initiatedAt       DateTime       @default(now())
  completedAt       DateTime?
  gatewayResponse   String?
  callbackPayload   String?
  errorCode         String?
  errorMessage      String?
  customerMsisdn    String?
  merchantInvoice   String?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model NewsArticle {
  id            String   @id @default(uuid())
  title         String
  category      String   // "School News", "Alumni News", "Events"
  excerpt       String
  content       String
  featuredImage String?
  author        String
  publishedAt   DateTime @default(now())
  isFeatured    Boolean  @default(false)
}

model AlumniStory {
  id          String   @id @default(uuid())
  title       String
  authorName  String
  batchYear   Int
  profession  String
  coverImage  String?
  summary     String
  fullStory   String
  quote       String?
  publishedAt DateTime @default(now())
}

model Achievement {
  id            String @id @default(uuid())
  recipientName String
  batchYear     Int
  category      String // "Doctor", "Engineer", "Entrepreneur", etc.
  title         String
  organization  String
  description   String
  photoUrl      String?
  yearAwarded   Int
}

model GalleryAlbum {
  id          String         @id @default(uuid())
  title       String
  category    String         // "Campus", "Old Days", "Reunions", "Sports"
  description String?
  coverUrl    String
  photosCount Int            @default(0)

  photos      GalleryPhoto[]

  createdAt   DateTime       @default(now())
}

model GalleryPhoto {
  id         String       @id @default(uuid())
  albumId    String
  album      GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  imageUrl   String
  caption    String?
  uploadedBy String?
  batchYear  Int?

  createdAt  DateTime     @default(now())
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String
  isRead     Boolean  @default(false)

  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  type      String   // "CONNECTION", "EVENT", "BATCH", "ADMIN"

  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  priority  String   @default("NORMAL") // "NORMAL", "HIGH", "URGENT"
  author    String   @default("Alumni Executive Committee")
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
}

model VerificationRequest {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sscBatch         Int
  rollNumber       String?
  proofDocumentUrl String?
  status           VerificationStatus @default(PENDING)
  reviewedBy       String?
  reviewNotes      String?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}
