datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  ALUMNI
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EventCategory {
  REUNION
  SPORTS
  WEBINAR
  CULTURAL
  COMMUNITY
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CANCELLED
}

enum CampaignCategory {
  SCHOLARSHIP
  STEM_LAB
  LIBRARY
  EMERGENCY_AID
  CAMPUS_DEV
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentGateway {
  BKASH
  NAGAD
  SSLCOMMERZ
  BANK_TRANSFER
  MANUAL
}

model User {
  id           String             @id @default(uuid()) @db.VarChar(36)
  email        String             @unique
  passwordHash String
  role         Role               @default(ALUMNI)
  status       VerificationStatus @default(PENDING)
  sessionVersion Int               @default(0)
  /// Set when an admin disables the account: it can no longer sign in, staff included.
  disabledAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  profile              AlumniProfile?
  posts                Post[]
  comments             Comment[]
  eventRegistrations   EventRegistration[]
  donations            Donation[]
  sentMessages         Message[]             @relation("SentMessages")
  receivedMessages     Message[]             @relation("ReceivedMessages")
  notifications        Notification[]
  verificationRequests VerificationRequest[]
}

model AlumniProfile {
  id     String @id @default(uuid()) @db.VarChar(36)
  userId String @unique @db.VarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName           String
  sscBatch           Int // e.g. 2008
  graduationYear     Int // e.g. 2008
  rollNumber         String?
  section            String?
  gender             String?
  profession         String
  company            String?
  industry           String?
  locationCity       String // e.g. Dhaka
  locationCountry    String // e.g. Bangladesh
  bio                String?            @db.Text
  avatarUrl          String?            @db.VarChar(500)
  avatarOriginalUrl  String?            @db.VarChar(500)
  coverUrl           String?            @db.VarChar(500)
  phone              String?
  isPhonePublic      Boolean            @default(false)
  isEmailPublic      Boolean            @default(false)
  skills             Json               @default("[]")
  linkedin           String?            @db.VarChar(500)
  facebook           String?            @db.VarChar(500)
  github             String?            @db.VarChar(500)
  website            String?            @db.VarChar(500)
  schoolMemories     String?            @db.Text
  contributions      String?            @db.Text
  verificationStatus VerificationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Batch {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  year                Int       @unique // e.g. 2008
  name                String // e.g. "SSC Batch 2008"
  tagline             String?   @db.VarChar(500)
  totalMembers        Int       @default(0)
  classRepresentative String?
  representativePhone String?
  reunionDate         DateTime?
  reunionCount        Int       @default(0)
  coverImage          String?   @db.VarChar(500)
  description         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id            String  @id @default(uuid()) @db.VarChar(36)
  authorId      String  @db.VarChar(36)
  author        User    @relation(fields: [authorId], references: [id])
  batchTag      Int?
  content       String  @db.Text
  images        Json    @default("[]")
  likesCount    Int     @default(0)
  commentsCount Int     @default(0)
  isPinned      Boolean @default(false)

  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id       String @id @default(uuid()) @db.VarChar(36)
  postId   String @db.VarChar(36)
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String @db.VarChar(36)
  author   User   @relation(fields: [authorId], references: [id])
  content  String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id                   String        @id @default(uuid()) @db.VarChar(36)
  slug                 String        @unique
  title                String
  category             EventCategory @default(REUNION)
  description          String        @db.Text
  date                 DateTime
  time                 String?
  venue                String        @db.VarChar(500)
  locationCity         String        @default("Dhaka")
  organizer            String?
  bannerImage          String?       @db.VarChar(500)
  maxAttendees         Int           @default(500)
  attendeesCount       Int           @default(0)
  registrationFee      Float         @default(0)
  isRegistrationOpen   Boolean       @default(true)
  subtitle             String?
  guestOfHonor         String?
  souvenirDetails      String?       @db.Text
  registrationDeadline DateTime?
  isMegaEvent          Boolean       @default(false)
  isMembershipEvent    Boolean       @default(false)
  agenda               Json          @default("[]")
  highlights           Json          @default("[]")
  packages             Json          @default("[]")
  extraAdultFee        Float         @default(0)
  childFee             Float         @default(0)
  paymentInstructions  String?       @db.Text

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventRegistration {
  id             String             @id @default(uuid()) @db.VarChar(36)
  eventId        String             @db.VarChar(36)
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String             @db.VarChar(36)
  user           User               @relation(fields: [userId], references: [id])
  guestCount     Int                @default(1)
  mealPreference String?
  notes          String?            @db.Text
  packageName    String?
  extraAdults    Int                @default(0)
  extraChildren  Int                @default(0)
  headCount      Int                @default(1)
  tshirtSize     String?
  totalFee       Float              @default(0)
  donationAmount Float              @default(0)
  paymentMethod  String?
  transactionId  String?            @unique
  status         RegistrationStatus @default(PENDING_PAYMENT)
  confirmedBy    String?
  confirmedAt    DateTime?
  checkedInAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([eventId, userId])
}

model DonationCampaign {
  id           String           @id @default(uuid()) @db.VarChar(36)
  slug         String           @unique
  title        String
  category     CampaignCategory @default(SCHOLARSHIP)
  description  String           @db.Text
  goalAmount   Float            @default(0)
  raisedAmount Float            @default(0)
  donorCount   Int              @default(0)
  bannerImage  String?          @db.VarChar(500)
  isActive     Boolean          @default(true)
  startDate    DateTime         @default(now())
  endDate      DateTime?

  donations Donation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Donation {
  id             String           @id @default(uuid()) @db.VarChar(36)
  campaignId     String           @db.VarChar(36)
  campaign       DonationCampaign @relation(fields: [campaignId], references: [id])
  userId         String?          @db.VarChar(36)
  user           User?            @relation(fields: [userId], references: [id])
  donorName      String
  donorEmail     String?
  donorPhone     String?
  donorBatch     Int?
  amount         Float
  paymentMethod  String // "bKash", "Nagad", "Card", "Bank"
  paymentGateway PaymentGateway   @default(BKASH)
  paymentStatus  PaymentStatus    @default(INITIATED)
  isAnonymous    Boolean          @default(false)
  transactionRef String?
  gatewayTrxId   String?
  receiptId      String?
  receiptUrl     String?          @db.VarChar(500)
  paidAt         DateTime?
  failureReason  String?          @db.Text
  ipnPayload     String?          @db.Text

  transaction PaymentTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentTransaction {
  id                String         @id @default(uuid()) @db.VarChar(36)
  donationId        String         @unique @db.VarChar(36)
  donation          Donation       @relation(fields: [donationId], references: [id], onDelete: Cascade)
  gateway           PaymentGateway
  gatewaySessionKey String?        @db.VarChar(500)
  gatewayTrxId      String?
  amount            Float
  currency          String         @default("BDT")
  status            PaymentStatus  @default(INITIATED)
  initiatedAt       DateTime       @default(now())
  completedAt       DateTime?
  gatewayResponse   String?        @db.Text
  callbackPayload   String?        @db.Text
  errorCode         String?
  errorMessage      String?        @db.Text
  customerMsisdn    String?
  merchantInvoice   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// News on /news, managed in /admin/news (lib/news.ts). Only published rows are public.
model NewsArticle {
  id            String   @id @default(uuid()) @db.VarChar(36)
  title         String
  category      String // "School News", "Alumni News", "Events", "Announcements"
  excerpt       String   @db.Text
  /// Plain text; blank lines separate paragraphs. Never rendered as HTML.
  content       String   @db.LongText
  featuredImage String?  @db.VarChar(500)
  author        String
  /// Drafts are visible only in the admin panel. Rows that existed before this
  /// column (seeded samples) become drafts.
  isPublished   Boolean  @default(false)
  publishedAt   DateTime @default(now())
  isFeatured    Boolean  @default(false)
  createdBy     String?  @db.VarChar(254)
  updatedBy     String?  @db.VarChar(254)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([isPublished, publishedAt])
}

model AlumniStory {
  id          String   @id @default(uuid()) @db.VarChar(36)
  title       String
  authorName  String
  batchYear   Int
  profession  String
  coverImage  String?  @db.VarChar(500)
  summary     String   @db.Text
  fullStory   String   @db.LongText
  quote       String?  @db.Text
  publishedAt DateTime @default(now())
}

model Achievement {
  id            String  @id @default(uuid()) @db.VarChar(36)
  recipientName String
  batchYear     Int
  category      String // "Doctor", "Engineer", "Entrepreneur", etc.
  title         String
  organization  String
  description   String  @db.Text
  photoUrl      String? @db.VarChar(500)
  yearAwarded   Int
}

/// Photo albums on /gallery, managed in /admin/gallery (lib/gallery.ts). Only
/// published albums are public; rows that existed before isPublished (seeded
/// samples) become unpublished.
model GalleryAlbum {
  id          String   @id @default(uuid()) @db.VarChar(36)
  title       String
  category    String // one of GALLERY_CATEGORIES in lib/gallery.ts
  description String?  @db.Text
  /// Cover photo; defaults to the first photo when empty.
  coverUrl    String?  @db.VarChar(500)
  photosCount Int      @default(0)
  year        Int?
  isPublished Boolean  @default(false)
  createdBy   String?  @db.VarChar(254)
  updatedBy   String?  @db.VarChar(254)

  photos GalleryPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isPublished, createdAt])
}

model GalleryPhoto {
  id         String       @id @default(uuid()) @db.VarChar(36)
  albumId    String       @db.VarChar(36)
  album      GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  imageUrl   String       @db.VarChar(500)
  caption    String?      @db.VarChar(500)
  uploadedBy String?
  batchYear  Int?
  sortOrder  Int          @default(0)

  createdAt DateTime @default(now())

  @@index([albumId, sortOrder])
}

model Message {
  id         String  @id @default(uuid()) @db.VarChar(36)
  senderId   String  @db.VarChar(36)
  sender     User    @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String  @db.VarChar(36)
  receiver   User    @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String  @db.Text
  isRead     Boolean @default(false)

  createdAt DateTime @default(now())
}

model Notification {
  id      String  @id @default(uuid()) @db.VarChar(36)
  userId  String  @db.VarChar(36)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  message String  @db.Text
  link    String? @db.VarChar(500)
  isRead  Boolean @default(false)
  type    String // "CONNECTION", "EVENT", "BATCH", "ADMIN"

  createdAt DateTime @default(now())
}

model Announcement {
  id       String  @id @default(uuid()) @db.VarChar(36)
  title    String
  content  String  @db.Text
  priority String  @default("NORMAL") // "NORMAL", "HIGH", "URGENT"
  author   String  @default("Alumni Executive Committee")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

model VerificationRequest {
  id               String             @id @default(uuid()) @db.VarChar(36)
  userId           String             @db.VarChar(36)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sscBatch         Int
  rollNumber       String?
  proofDocumentUrl String?            @db.VarChar(500)
  // Proof of study uploaded when joining (lib/media/proofs.ts). Admin-only; the
  // file is deleted once the membership is decided (proofFileUrl -> null,
  // proofDeletedAt set), while the type, note and reviewer stay on record.
  proofType        String?            @db.VarChar(40)
  proofNote        String?            @db.VarChar(200)
  proofFileUrl     String?            @db.VarChar(500)
  proofMime        String?            @db.VarChar(50)
  proofDeletedAt   DateTime?
  status           VerificationStatus @default(PENDING)
  reviewedBy       String?
  reviewNotes      String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Audit trail: who did what, when and from where. No foreign key to User, so
/// entries outlive deleted accounts. Written by lib/activity-log.ts only.
model ActivityLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  createdAt  DateTime @default(now())
  category   String   @db.VarChar(20)
  action     String   @db.VarChar(60)
  status     String   @default("SUCCESS") @db.VarChar(10)
  actorId    String?  @db.VarChar(36)
  actorEmail String?  @db.VarChar(255)
  actorRole  String?  @db.VarChar(20)
  targetType String?  @db.VarChar(40)
  targetId   String?  @db.VarChar(191)
  summary    String   @db.VarChar(500)
  metadata   Json?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([actorId, createdAt])
}

/// A volunteer application for an event subcommittee (lib/volunteers.ts). Replaces
/// the old uploads/volunteers.json store.
model Volunteer {
  id           String    @id @default(uuid()) @db.VarChar(64)
  fullName     String    @db.VarChar(120)
  email        String    @db.VarChar(254)
  phone        String    @db.VarChar(30)
  sscBatch     Int
  subcommittee String    @db.VarChar(40)
  skills       String?   @db.Text
  availability String?   @db.VarChar(200)
  experience   String?   @db.Text
  notes        String?   @db.Text
  source       String    @default("PUBLIC_APPLICATION") @db.VarChar(30)
  status       String    @default("PENDING") @db.VarChar(20)
  userId       String?   @db.VarChar(36)
  decidedBy    String?   @db.VarChar(254)
  decidedAt    DateTime?
  appliedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, appliedAt])
  @@index([email])
}

/// One bulk SMS send from /admin/sms (lib/sms-history.ts). Replaces the old
/// uploads/sms-history.json file.
model SmsBroadcast {
  id                  String   @id @default(uuid()) @db.VarChar(64)
  createdAt           DateTime @default(now())
  status              String   @default("SENT") @db.VarChar(10)
  sentBy              String   @db.VarChar(254)
  senderId            String   @db.VarChar(40)
  message             String   @db.Text
  charCount           Int
  isUnicode           Boolean
  partsCount          Int
  totalRecipients     Int
  validRecipients     Int
  invalidRecipients   Int
  totalCreditsUsed    Int
  isSimulated         Boolean
  gatewayResponseCode Int?
  messageId           String?  @db.VarChar(100)
  error               String?  @db.Text
  /// Every number the message went to (normalized 8801XXXXXXXXX).
  recipients          Json

  @@index([createdAt])
}
