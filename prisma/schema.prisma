datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  /// Keeps the association's accounts (/admin/accounts) and nothing else.
  TREASURER
  ALUMNI
}

enum FinanceAccountType {
  CASH
  BKASH
  NAGAD
  BANK
  BANGLA_QR
  OTHER
}

enum FinanceKind {
  INCOME
  EXPENSE
  TRANSFER
}

enum FinanceEntryStatus {
  PENDING
  APPROVED
  VOID
}

enum FinanceSource {
  MANUAL
  REGISTRATION
  DONATION
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EventCategory {
  REUNION
  SPORTS
  WEBINAR
  CULTURAL
  COMMUNITY
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CANCELLED
}

enum CampaignCategory {
  SCHOLARSHIP
  STEM_LAB
  LIBRARY
  EMERGENCY_AID
  CAMPUS_DEV
  REUNION
  SPORTS
  CULTURAL
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentGateway {
  BKASH
  NAGAD
  SSLCOMMERZ
  BANK_TRANSFER
  MANUAL
}

model User {
  id             String             @id @default(uuid()) @db.VarChar(36)
  email          String             @unique
  passwordHash   String
  role           Role               @default(ALUMNI)
  status         VerificationStatus @default(PENDING)
  sessionVersion Int                @default(0)
  /// Set when an admin disables the account: it can no longer sign in, staff included.
  disabledAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  profile              AlumniProfile?
  posts                Post[]
  comments             Comment[]
  eventRegistrations   EventRegistration[]
  donations            Donation[]
  sentMessages         Message[]             @relation("SentMessages")
  receivedMessages     Message[]             @relation("ReceivedMessages")
  notifications        Notification[]
  verificationRequests VerificationRequest[]
}

model AlumniProfile {
  id     String @id @default(uuid()) @db.VarChar(36)
  userId String @unique @db.VarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName           String
  sscBatch           Int // e.g. 2008
  graduationYear     Int // e.g. 2008
  rollNumber         String?
  /// Optional: A+, A-, B+, B-, AB+, AB-, O+ or O- (lib/members/blood-groups.ts).
  bloodGroup         String?            @db.VarChar(3)
  /// Asked on the join form (lib/members/date-of-birth.ts); never shown publicly.
  dateOfBirth        DateTime?          @db.Date
  section            String?
  gender             String?
  profession         String
  company            String?
  /// Job title / designation (পদবী), e.g. "Assistant Professor".
  designation        String?            @db.VarChar(100)
  /// Present address (ঠিকানা). Shown only to the member and the committee, never publicly.
  address            String?            @db.VarChar(255)
  industry           String?
  locationCity       String // e.g. Dhaka
  locationCountry    String // e.g. Bangladesh
  bio                String?            @db.Text
  avatarUrl          String?            @db.VarChar(500)
  avatarOriginalUrl  String?            @db.VarChar(500)
  coverUrl           String?            @db.VarChar(500)
  /// 01XXXXXXXXX; one account per number (lib/phone-registry.ts).
  phone              String?            @unique @db.VarChar(20)
  isPhonePublic      Boolean            @default(false)
  isEmailPublic      Boolean            @default(false)
  skills             Json               @default("[]")
  /// Education after SSC: [{ level, institution, subject, year }] (lib/members/education.ts).
  education          Json               @default("[]")
  /// Work experience: [{ title, company, type, location, start, end, current, description }] (lib/members/experience.ts).
  experience         Json               @default("[]")
  linkedin           String?            @db.VarChar(500)
  facebook           String?            @db.VarChar(500)
  github             String?            @db.VarChar(500)
  website            String?            @db.VarChar(500)
  schoolMemories     String?            @db.Text
  contributions      String?            @db.Text
  verificationStatus VerificationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Batch {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  year                Int       @unique // e.g. 2008
  name                String // e.g. "SSC Batch 2008"
  tagline             String?   @db.VarChar(500)
  totalMembers        Int       @default(0)
  classRepresentative String?
  representativePhone String?
  reunionDate         DateTime?
  reunionCount        Int       @default(0)
  coverImage          String?   @db.VarChar(500)
  description         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id            String  @id @default(uuid()) @db.VarChar(36)
  authorId      String  @db.VarChar(36)
  author        User    @relation(fields: [authorId], references: [id])
  batchTag      Int?
  content       String  @db.Text
  images        Json    @default("[]")
  likesCount    Int     @default(0)
  commentsCount Int     @default(0)
  isPinned      Boolean @default(false)

  comments Comment[]
  likes    PostLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id       String @id @default(uuid()) @db.VarChar(36)
  postId   String @db.VarChar(36)
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String @db.VarChar(36)
  author   User   @relation(fields: [authorId], references: [id])
  content  String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id                   String        @id @default(uuid()) @db.VarChar(36)
  slug                 String        @unique
  title                String
  category             EventCategory @default(REUNION)
  description          String        @db.Text
  date                 DateTime
  /// The date is not fixed yet: shown as "Around 26 December 2026 (date to be confirmed)".
  dateTentative        Boolean       @default(false)
  time                 String?
  venue                String        @db.VarChar(500)
  locationCity         String        @default("Dhaka")
  organizer            String?
  bannerImage          String?       @db.VarChar(500)
  maxAttendees         Int           @default(500)
  attendeesCount       Int           @default(0)
  registrationFee      Float         @default(0)
  isRegistrationOpen   Boolean       @default(true)
  subtitle             String?
  guestOfHonor         String?
  souvenirDetails      String?       @db.Text
  registrationDeadline DateTime?
  isMegaEvent          Boolean       @default(false)
  isMembershipEvent    Boolean       @default(false)
  agenda               Json          @default("[]")
  highlights           Json          @default("[]")
  packages             Json          @default("[]")
  extraAdultFee        Float         @default(0)
  childFee             Float         @default(0)
  /// [{ name, price, max }]: guests a member can add (e.g. Spouse, Child). Empty: extraAdultFee / childFee apply.
  /// The member's fee by SSC batch: [{ fromBatch, toBatch, price }] (lib/events/pricing.ts).
  batchFees            Json          @default("[]")
  guestTypes           Json          @default("[]")
  paymentInstructions  String?       @db.Text

  registrations  EventRegistration[]
  financeEntries FinanceEntry[]
  budgetLines    EventBudgetLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventRegistration {
  id                String             @id @default(uuid()) @db.VarChar(36)
  eventId           String             @db.VarChar(36)
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId            String             @db.VarChar(36)
  user              User               @relation(fields: [userId], references: [id])
  guestCount        Int                @default(1)
  mealPreference    String?
  notes             String?            @db.Text
  packageName       String?
  extraAdults       Int                @default(0)
  extraChildren     Int                @default(0)
  /// [{ name, count, price }]: guests added, with the price each paid
  guests            Json               @default("[]")
  /// Where the member came from, e.g. "facebook/jubilee2026" (the /jubilee link's utm_source/utm_campaign)
  source            String?            @db.VarChar(80)
  headCount         Int                @default(1)
  tshirtSize        String?
  totalFee          Float              @default(0)
  donationAmount    Float              @default(0)
  paymentMethod     String?
  /// The ID the member typed from their own app's receipt.
  transactionId     String?            @unique
  /// Bangla QR: last 4 digits of the account the member paid from, and when they say they paid
  /// (matched against the association's OK Wallet SMS, lib/payments/bangla-qr.ts).
  payerAccountLast4 String?            @db.VarChar(4)
  payerPaidAt       DateTime?
  /// Bangla QR: the TrxID in the association's own SMS, recorded by the admin on confirming.
  merchantTrxId     String?            @unique @db.VarChar(40)
  status            RegistrationStatus @default(PENDING_PAYMENT)
  confirmedBy       String?
  confirmedAt       DateTime?
  checkedInAt       DateTime?
  /// Single-use food and kit tokens printed for this registration (lib/events/tokens.ts).
  tokens            EventToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([eventId, userId])
}

/// One printed food or kit token: a meal for one person (BREAKFAST, LUNCH, DINNER;
/// person 1..headCount) or the T-shirt and gift kit (KIT, person 1). Scanned once
/// at a food counter in the gate app (lib/events/tokens.ts).
model EventToken {
  id             String            @id @default(uuid()) @db.VarChar(36)
  registrationId String            @db.VarChar(36)
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  kind           String            @db.VarChar(20)
  person         Int
  usedAt         DateTime?
  usedBy         String?           @db.VarChar(254)
  createdAt      DateTime          @default(now())

  @@unique([registrationId, kind, person])
  @@index([registrationId])
}

model DonationCampaign {
  id           String           @id @default(uuid()) @db.VarChar(36)
  slug         String           @unique
  title        String
  category     CampaignCategory @default(SCHOLARSHIP)
  description  String           @db.Text
  goalAmount   Float            @default(0)
  raisedAmount Float            @default(0)
  donorCount   Int              @default(0)
  bannerImage  String?          @db.VarChar(500)
  isActive     Boolean          @default(true)
  startDate    DateTime         @default(now())
  endDate      DateTime?

  donations Donation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Donation {
  id                   String           @id @default(uuid()) @db.VarChar(36)
  campaignId           String           @db.VarChar(36)
  campaign             DonationCampaign @relation(fields: [campaignId], references: [id])
  userId               String?          @db.VarChar(36)
  user                 User?            @relation(fields: [userId], references: [id])
  donorName            String
  donorEmail           String?
  donorPhone           String?
  donorBatch           Int?
  amount               Float
  paymentMethod        String // "bKash", "Nagad", "Card", "Bank"
  paymentGateway       PaymentGateway   @default(BKASH)
  paymentStatus        PaymentStatus    @default(INITIATED)
  isAnonymous          Boolean          @default(false)
  transactionRef       String?
  /// Bangla QR: last 4 digits of the paying account, when the donor says they paid, and the
  /// TrxID in the association's own SMS (recorded by the admin on confirming).
  payerAccountLast4    String?          @db.VarChar(4)
  payerPaidAt          DateTime?
  merchantTrxId        String?          @unique @db.VarChar(40)
  /// Screenshot of the donor's payment receipt (lib/media/receipts.ts), admins only.
  paymentScreenshotUrl String?          @db.VarChar(500)
  gatewayTrxId         String?
  receiptId            String?
  receiptUrl           String?          @db.VarChar(500)
  paidAt               DateTime?
  failureReason        String?          @db.Text
  ipnPayload           String?          @db.Text

  transaction PaymentTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentTransaction {
  id                String         @id @default(uuid()) @db.VarChar(36)
  donationId        String         @unique @db.VarChar(36)
  donation          Donation       @relation(fields: [donationId], references: [id], onDelete: Cascade)
  gateway           PaymentGateway
  gatewaySessionKey String?        @db.VarChar(500)
  gatewayTrxId      String?
  amount            Float
  currency          String         @default("BDT")
  status            PaymentStatus  @default(INITIATED)
  initiatedAt       DateTime       @default(now())
  completedAt       DateTime?
  gatewayResponse   String?        @db.Text
  callbackPayload   String?        @db.Text
  errorCode         String?
  errorMessage      String?        @db.Text
  customerMsisdn    String?
  merchantInvoice   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// News on /news, managed in /admin/news (lib/news.ts). Only published rows are public.
model NewsArticle {
  id            String   @id @default(uuid()) @db.VarChar(36)
  title         String
  category      String // "School News", "Alumni News", "Events", "Announcements"
  excerpt       String   @db.Text
  /// Plain text; blank lines separate paragraphs. Never rendered as HTML.
  content       String   @db.LongText
  featuredImage String?  @db.VarChar(500)
  author        String
  /// Drafts are visible only in the admin panel. Rows that existed before this
  /// column (seeded samples) become drafts.
  isPublished   Boolean  @default(false)
  publishedAt   DateTime @default(now())
  isFeatured    Boolean  @default(false)
  createdBy     String?  @db.VarChar(254)
  updatedBy     String?  @db.VarChar(254)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([isPublished, publishedAt])
}

/// Alumni stories on /stories, managed in /admin/stories (lib/stories.ts). Only
/// published rows are public; rows that existed before isPublished (seeded
/// samples) become drafts.
model AlumniStory {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  title               String
  authorName          String
  batchYear           Int
  profession          String
  currentOrganization String?  @db.VarChar(200)
  coverImage          String?  @db.VarChar(500)
  summary             String   @db.Text
  /// Plain text; blank lines separate paragraphs. Never rendered as HTML.
  fullStory           String   @db.LongText
  quote               String?  @db.Text
  isPublished         Boolean  @default(false)
  isFeatured          Boolean  @default(false)
  publishedAt         DateTime @default(now())
  createdBy           String?  @db.VarChar(254)
  updatedBy           String?  @db.VarChar(254)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([isPublished, publishedAt])
}

/// Alumni achievements on /achievements, managed in /admin/stories
/// (lib/achievements.ts). Only published rows are public; rows that existed
/// before isPublished (seeded samples) become drafts.
model Achievement {
  id            String   @id @default(uuid()) @db.VarChar(36)
  recipientName String
  batchYear     Int
  category      String // one of ACHIEVEMENT_CATEGORIES in lib/achievements.ts
  title         String
  organization  String
  description   String   @db.Text
  photoUrl      String?  @db.VarChar(500)
  yearAwarded   Int
  isPublished   Boolean  @default(false)
  createdBy     String?  @db.VarChar(254)
  updatedBy     String?  @db.VarChar(254)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([isPublished, yearAwarded])
}

/// Photo albums on /gallery, managed in /admin/gallery (lib/gallery.ts). Only
/// published albums are public; rows that existed before isPublished (seeded
/// samples) become unpublished.
model GalleryAlbum {
  id          String  @id @default(uuid()) @db.VarChar(36)
  title       String
  category    String // one of GALLERY_CATEGORIES in lib/gallery.ts
  description String? @db.Text
  /// Cover photo; defaults to the first photo when empty.
  coverUrl    String? @db.VarChar(500)
  photosCount Int     @default(0)
  year        Int?
  isPublished Boolean @default(false)
  createdBy   String? @db.VarChar(254)
  updatedBy   String? @db.VarChar(254)

  photos GalleryPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isPublished, createdAt])
}

model GalleryPhoto {
  id         String       @id @default(uuid()) @db.VarChar(36)
  albumId    String       @db.VarChar(36)
  album      GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  imageUrl   String       @db.VarChar(500)
  caption    String?      @db.VarChar(500)
  uploadedBy String?
  batchYear  Int?
  sortOrder  Int          @default(0)

  createdAt DateTime @default(now())

  @@index([albumId, sortOrder])
}

model Message {
  id         String  @id @default(uuid()) @db.VarChar(36)
  senderId   String  @db.VarChar(36)
  sender     User    @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String  @db.VarChar(36)
  receiver   User    @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String  @db.Text
  isRead     Boolean @default(false)

  createdAt DateTime @default(now())
}

model Notification {
  id      String  @id @default(uuid()) @db.VarChar(36)
  userId  String  @db.VarChar(36)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  message String  @db.Text
  link    String? @db.VarChar(500)
  isRead  Boolean @default(false)
  type    String // "CONNECTION", "EVENT", "BATCH", "ADMIN"

  createdAt DateTime @default(now())
}

/// Notices on /notices, managed in /admin/notices (lib/notices.ts). Only active rows are public.
model Announcement {
  id            String   @id @default(uuid()) @db.VarChar(36)
  title         String
  /// Plain text; blank lines separate paragraphs. Never rendered as HTML.
  content       String   @db.Text
  priority      String   @default("NORMAL") // "NORMAL", "HIGH", "URGENT"
  author        String   @default("Alumni Executive Committee")
  isActive      Boolean  @default(true)
  /// Optional PDF stored by lib/media/documents.ts.
  attachmentUrl String?  @db.VarChar(500)
  publishedAt   DateTime @default(now())
  createdBy     String?  @db.VarChar(254)
  updatedBy     String?  @db.VarChar(254)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive, publishedAt])
}

/// A committee term on /committee (the current one) and /committee/past, managed in
/// /admin/committee (lib/committee.ts). At most one term is current.
model CommitteeTerm {
  id        String   @id @default(uuid()) @db.VarChar(36)
  title     String   @db.VarChar(200)
  startYear Int
  endYear   Int?
  isCurrent Boolean  @default(false)
  /// Group photo or scanned list, shown for past terms (content image URL).
  imageUrl  String?  @db.VarChar(500)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  members CommitteeMember[]

  @@index([isCurrent])
}

model CommitteeMember {
  id           String  @id @default(uuid()) @db.VarChar(36)
  termId       String  @db.VarChar(36)
  name         String  @db.VarChar(200)
  post         String  @db.VarChar(200)
  lifeMemberNo String? @db.VarChar(40)
  sscBatch     Int?
  phone        String? @db.VarChar(40)
  facebookUrl  String? @db.VarChar(500)
  photoUrl     String? @db.VarChar(500)
  /// Extra line, e.g. "Head teacher (ex officio)".
  note         String? @db.VarChar(300)
  sortOrder    Int     @default(0)

  term CommitteeTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([termId, sortOrder])
}

/// Names on /honor-board, grouped by honour, managed in /admin/honor-board (lib/honor-board.ts).
model HonorBoardEntry {
  id        String   @id @default(uuid()) @db.VarChar(36)
  /// Group heading, e.g. "Past presidents".
  honour    String   @db.VarChar(200)
  name      String   @db.VarChar(200)
  /// Free text such as "2006–2010".
  period    String?  @db.VarChar(100)
  sscBatch  Int?
  photoUrl  String?  @db.VarChar(500)
  note      String?  @db.VarChar(300)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum SponsorCategory {
  INFRASTRUCTURE
  DEVELOPMENT
  EVENT
  SCHOLARSHIP
  SUPPORTER
}

/// Supporters on /sponsors, grouped by category, managed in /admin/sponsors
/// (lib/sponsors.ts). The first published INFRASTRUCTURE sponsor is also credited
/// in the footer and on the home page.
model Sponsor {
  id          String          @id @default(uuid()) @db.VarChar(36)
  category    SponsorCategory @default(SUPPORTER)
  /// Name as shown first, usually in Bangla.
  name        String          @db.VarChar(200)
  nameEn      String?         @db.VarChar(200)
  address     String?         @db.VarChar(300)
  /// One line under the name, e.g. what they support or their motto.
  note        String?         @db.VarChar(500)
  website     String?         @db.VarChar(500)
  logoUrl     String?         @db.VarChar(500)
  isPublished Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  @@index([isPublished, category, sortOrder])
}

/// Constitution versions on /constitution, each a PDF, managed in /admin/constitution
/// (lib/constitution.ts).
model ConstitutionDocument {
  id        String   @id @default(uuid()) @db.VarChar(36)
  title     String   @db.VarChar(200)
  year      Int
  summary   String?  @db.Text
  fileUrl   String   @db.VarChar(500)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// Site settings edited in the admin panel, one JSON value per key (e.g. "payment":
/// bKash / Nagad numbers, bank details, Bangla QR image). Read by lib/payment-settings.ts.
model Setting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedBy String?  @db.VarChar(255)
  updatedAt DateTime @updatedAt
}

model VerificationRequest {
  id               String             @id @default(uuid()) @db.VarChar(36)
  userId           String             @db.VarChar(36)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sscBatch         Int
  rollNumber       String?
  proofDocumentUrl String?            @db.VarChar(500)
  // Proof of study uploaded when joining (lib/media/proofs.ts). Admin-only and
  // kept on record after the decision. proofDeletedAt is set only on requests
  // decided before 2026-10-29, when proofs were still deleted at the decision.
  proofType        String?            @db.VarChar(40)
  proofNote        String?            @db.VarChar(200)
  proofFileUrl     String?            @db.VarChar(500)
  proofMime        String?            @db.VarChar(50)
  proofDeletedAt   DateTime?
  status           VerificationStatus @default(PENDING)
  reviewedBy       String?
  reviewNotes      String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Audit trail: who did what, when and from where. No foreign key to User, so
/// entries outlive deleted accounts. Written by lib/activity-log.ts only.
model ActivityLog {
  id         String   @id @default(uuid()) @db.VarChar(36)
  createdAt  DateTime @default(now())
  category   String   @db.VarChar(20)
  action     String   @db.VarChar(60)
  status     String   @default("SUCCESS") @db.VarChar(10)
  actorId    String?  @db.VarChar(36)
  actorEmail String?  @db.VarChar(255)
  actorRole  String?  @db.VarChar(20)
  targetType String?  @db.VarChar(40)
  targetId   String?  @db.VarChar(191)
  summary    String   @db.VarChar(500)
  metadata   Json?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([actorId, createdAt])
}

/// A volunteer application for an event subcommittee (lib/volunteers.ts). Replaces
/// the old uploads/volunteers.json store.
model Volunteer {
  id           String    @id @default(uuid()) @db.VarChar(64)
  fullName     String    @db.VarChar(120)
  email        String    @db.VarChar(254)
  phone        String    @db.VarChar(30)
  sscBatch     Int
  subcommittee String    @db.VarChar(40)
  skills       String?   @db.Text
  availability String?   @db.VarChar(200)
  experience   String?   @db.Text
  notes        String?   @db.Text
  source       String    @default("PUBLIC_APPLICATION") @db.VarChar(30)
  status       String    @default("PENDING") @db.VarChar(20)
  userId       String?   @db.VarChar(36)
  decidedBy    String?   @db.VarChar(254)
  decidedAt    DateTime?
  appliedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, appliedAt])
  @@index([email])
}

/// One bulk SMS send from /admin/sms (lib/sms-history.ts). Replaces the old
/// uploads/sms-history.json file.
model SmsBroadcast {
  id                  String   @id @default(uuid()) @db.VarChar(64)
  createdAt           DateTime @default(now())
  status              String   @default("SENT") @db.VarChar(10)
  sentBy              String   @db.VarChar(254)
  senderId            String   @db.VarChar(40)
  message             String   @db.Text
  charCount           Int
  isUnicode           Boolean
  partsCount          Int
  totalRecipients     Int
  validRecipients     Int
  invalidRecipients   Int
  totalCreditsUsed    Int
  isSimulated         Boolean
  gatewayResponseCode Int?
  messageId           String?  @db.VarChar(100)
  error               String?  @db.Text
  /// Every number the message went to (normalized 8801XXXXXXXXX).
  recipients          Json

  @@index([createdAt])
}

/// A job posted on /careers by a verified member (lib/jobs.ts). Members' posts
/// wait for an admin to approve them; only APPROVED jobs are public.
model Job {
  id              String    @id @default(uuid()) @db.VarChar(36)
  title           String    @db.VarChar(200)
  company         String    @db.VarChar(200)
  location        String    @db.VarChar(120)
  workplaceType   String    @db.VarChar(20)
  jobType         String    @db.VarChar(20)
  department      String    @db.VarChar(80)
  salaryRange     String?   @db.VarChar(80)
  experienceLevel String    @db.VarChar(30)
  description     String    @db.Text
  requirements    Json
  benefits        Json
  deadline        DateTime
  /// PENDING (awaiting review), APPROVED (public), REJECTED, CLOSED.
  status          String    @default("PENDING") @db.VarChar(20)
  postedById      String    @db.VarChar(36)
  postedByEmail   String    @db.VarChar(254)
  postedByName    String    @db.VarChar(120)
  postedByBatch   Int?
  reviewedBy      String?   @db.VarChar(254)
  reviewedAt      DateTime?
  rejectReason    String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  applications JobApplication[]

  @@index([status, deadline])
  @@index([postedById])
}

/// An application to a Job; the poster sees it in /careers/mine and by email.
model JobApplication {
  id              String   @id @default(uuid()) @db.VarChar(36)
  jobId           String   @db.VarChar(36)
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantUserId String?  @db.VarChar(36)
  name            String   @db.VarChar(120)
  email           String   @db.VarChar(254)
  phone           String?  @db.VarChar(30)
  sscBatch        Int?
  resumeUrl       String?  @db.VarChar(500)
  coverNote       String?  @db.Text
  createdAt       DateTime @default(now())

  @@unique([jobId, email])
}

/// A member who offers mentorship (lib/mentorship.ts). New profiles wait for an
/// admin to approve them; only APPROVED mentors are listed on /mentorship.
model Mentor {
  id                String    @id @default(uuid()) @db.VarChar(36)
  userId            String    @unique @db.VarChar(36)
  email             String    @db.VarChar(254)
  name              String    @db.VarChar(120)
  sscBatch          Int?
  designation       String    @db.VarChar(120)
  organization      String    @db.VarChar(200)
  domain            String    @db.VarChar(60)
  locationCity      String    @db.VarChar(120)
  avatarUrl         String?   @db.VarChar(500)
  bio               String    @db.Text
  yearsOfExperience Int       @default(0)
  availableDays     Json
  skills            Json
  topicsOffered     Json
  /// PENDING (awaiting review), APPROVED (listed), REJECTED, PAUSED (hidden by the mentor or an admin).
  status            String    @default("PENDING") @db.VarChar(20)
  reviewedBy        String?   @db.VarChar(254)
  reviewedAt        DateTime?
  rejectReason      String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  requests MentorshipRequest[]

  @@index([status])
}

/// A member's request for a mentorship session; the mentor accepts (sharing how
/// to meet) or declines it in /mentorship/mine.
model MentorshipRequest {
  id             String    @id @default(uuid()) @db.VarChar(36)
  mentorId       String    @db.VarChar(36)
  mentor         Mentor    @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  menteeUserId   String    @db.VarChar(36)
  menteeName     String    @db.VarChar(120)
  menteeEmail    String    @db.VarChar(254)
  menteeBatch    Int?
  topic          String    @db.VarChar(200)
  preferredTime  String?   @db.VarChar(120)
  message        String?   @db.Text
  /// PENDING, ACCEPTED, DECLINED, CANCELLED.
  status         String    @default("PENDING") @db.VarChar(20)
  meetingDetails String?   @db.VarChar(500)
  mentorReply    String?   @db.Text
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([mentorId, status])
  @@index([menteeUserId])
}

/// One member's like on a post (lib/feed.ts keeps Post.likesCount in step).
model PostLike {
  id        String   @id @default(uuid()) @db.VarChar(36)
  postId    String   @db.VarChar(36)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.VarChar(36)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

// ---- Accounts (lib/finance/*, /admin/accounts). Amounts are whole poisha (1/100 taka).

/// A place money is kept: cash in hand, a bKash / Nagad number, a bank account.
model FinanceAccount {
  id             String             @id @default(uuid()) @db.VarChar(36)
  name           String             @db.VarChar(120)
  type           FinanceAccountType
  /// The site payment method whose money lands here ("Cash", "bKash", "Nagad", "Bank", "Bangla QR").
  paymentMethod  String?            @unique @db.VarChar(20)
  openingBalance Int                @default(0)
  openingDate    DateTime           @db.Date
  isActive       Boolean            @default(true)
  sortOrder      Int                @default(0)
  note           String?            @db.VarChar(300)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt

  entries     FinanceEntry[] @relation("EntryAccount")
  transfersIn FinanceEntry[] @relation("EntryToAccount")
}

model FinanceCategory {
  id        String      @id @default(uuid()) @db.VarChar(36)
  name      String      @db.VarChar(120)
  kind      FinanceKind
  /// Set for categories the site posts to by itself (registration_fees, membership_fees, donations).
  systemKey String?     @unique @db.VarChar(40)
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  entries     FinanceEntry[]
  budgetLines EventBudgetLine[]
}

/// One voucher: money in (R-), out (P-) or moved between accounts (T-). Never deleted: voided.
model FinanceEntry {
  id            String             @id @default(uuid()) @db.VarChar(36)
  voucherNo     String             @unique @db.VarChar(20)
  kind          FinanceKind
  date          DateTime           @db.Date
  amount        Int
  accountId     String             @db.VarChar(36)
  toAccountId   String?            @db.VarChar(36)
  categoryId    String?            @db.VarChar(36)
  eventId       String?            @db.VarChar(36)
  /// Payer (income) or payee (expense).
  party         String?            @db.VarChar(160)
  description   String             @db.VarChar(500)
  /// Transaction ID, cheque or bill number.
  reference     String?            @db.VarChar(80)
  attachmentUrl String?            @db.VarChar(500)
  status        FinanceEntryStatus @default(PENDING)
  source        FinanceSource      @default(MANUAL)
  sourceId      String?            @db.VarChar(36)
  /// For site postings: "fee" or "donation" (one registration can post both).
  sourceLine    String             @default("") @db.VarChar(20)
  createdBy     String             @db.VarChar(254)
  approvedBy    String?            @db.VarChar(254)
  approvedAt    DateTime?
  voidedBy      String?            @db.VarChar(254)
  voidedAt      DateTime?
  voidReason    String?            @db.VarChar(300)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt

  account   FinanceAccount   @relation("EntryAccount", fields: [accountId], references: [id])
  toAccount FinanceAccount?  @relation("EntryToAccount", fields: [toAccountId], references: [id])
  category  FinanceCategory? @relation(fields: [categoryId], references: [id])
  event     Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([source, sourceId, sourceLine])
  @@index([accountId, date])
  @@index([eventId])
  @@index([status, date])
}

/// A planned amount for one category of an event's budget.
model EventBudgetLine {
  id            String   @id @default(uuid()) @db.VarChar(36)
  eventId       String   @db.VarChar(36)
  categoryId    String   @db.VarChar(36)
  label         String?  @db.VarChar(160)
  plannedAmount Int
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category FinanceCategory @relation(fields: [categoryId], references: [id])

  @@index([eventId])
}
