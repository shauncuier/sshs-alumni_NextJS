{
  "name": "sshs-alumni",
  "version": "0.1.0",
  "author": "3s-Soft (https://3s-soft.com)",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:https": "next dev --experimental-https -H 0.0.0.0 -p 3443",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:backfill-legacy": "tsx prisma/backfill-legacy-columns.ts",
    "db:push": "npm run db:backfill-legacy && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "tsx prisma/seed-prod.ts",
    "db:remove-demo": "tsx prisma/remove-demo.ts",
    "db:super-admin": "tsx scripts/ensure-super-admin.ts",
    "env:check": "tsx scripts/check-env.ts",
    "email:test": "tsx scripts/email-test.ts",
    "sms:test": "tsx scripts/sms-test.ts",
    "privacy:cleanup": "tsx scripts/privacy-cleanup.ts",
    "db:import-volunteers": "tsx scripts/import-volunteers.ts",
    "db:import-sms-history": "tsx scripts/import-sms-history.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "docker run -d --rm --name sshs-test-db -e MARIADB_ROOT_PASSWORD=test -p 127.0.0.1:3307:3306 mariadb:11",
    "test:admin": "tsx scripts/test-admin-suite.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.1.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "mariadb": "^3.5.4",
    "prisma": "^7.10.0",
